# YASIR PLAYBOX environment variables
# Copy to .env.local. Never commit .env.local.
# Values are intentionally blank.

# Public client configuration (RLS-protected anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional canonical URL used for metadata and sharing
NEXT_PUBLIC_APP_URL=
