# YASIR PLAYBOX environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local.

# Supabase project URL and public anon key (used by the browser auth client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection through the Supabase transaction pooler (runtime queries)
DATABASE_URL=

# Postgres direct connection (Prisma migrations)
DIRECT_URL=
